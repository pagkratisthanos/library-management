# Copy this file to .env and fill in a real signing key.
#
# The key signs and verifies the JWT tokens. Generate one with:
#   openssl rand -base64 32
# There is no default: the application refuses to start without it.
APP_SECURITY_SECRET_KEY=replace_me_run_openssl_rand_base64_32

# Token lifetime in milliseconds. 43200000 = 12 hours.
APP_SECURITY_JWT_EXPIRATION=43200000
